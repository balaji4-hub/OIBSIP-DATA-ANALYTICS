        "def levenshtein_distance(word1, word2):\n",
        "\n",
        "    word1 = word1.lower()\n",
        "    word2 = word2.lower()\n",
        "\n",
        "    rows = len(word1) + 1\n",
        "    cols = len(word2) + 1\n",
        "\n",
        "    dp = [\n",
        "        [0] * cols\n",
        "        for _ in range(rows)\n",
        "    ]\n",
        "\n",
        "    for i in range(rows):\n",
        "        dp[i][0] = i\n",
        "\n",
        "    for j in range(cols):\n",
        "        dp[0][j] = j\n",
        "\n",
        "    for i in range(1, rows):\n",
        "        for j in range(1, cols):\n",
        "\n",
        "            if word1[i - 1] == word2[j - 1]:\n",
        "                cost = 0\n",
        "            else:\n",
        "                cost = 1\n",
        "\n",
        "            dp[i][j] = min(\n",
        "                dp[i - 1][j] + 1,\n",
        "                dp[i][j - 1] + 1,\n",
        "                dp[i - 1][j - 1] + cost\n",
        "            )\n",
        "\n",
        "    return dp[-1][-1]"
      ],
