        "    if len(words) == 1:\n",
        "        predictions = autocomplete_bigram(\n",
        "            user_input,\n",
        "            top_n=3\n",
        "        )\n",
        "    elif len(words) >= 2:\n",
        "        predictions = autocomplete_trigram(\n",
        "            user_input,\n",
        "            top_n=3\n",
        "        )\n",
        "    else:\n",
        "        predictions = []\n",
        "\n",
        "    print(\"\\nAutocomplete suggestions:\")\n",
        "\n",
        "    if predictions:\n",
        "        for word, count in predictions:\n",
        "            print(f\"{user_input} {word}\")\n",
        "    else:\n",
        "        print(\"No predictions available for this input.\")\n",
